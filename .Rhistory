#'
#' @importFrom Matrix rowMeans t
#' @export
RunDimReduction_RNA <- function(obj,
method = "PCA",
layer_name = "data",
n_hvg = 2000,
pca_rank = 50,
use_dims = 1:20,
tsne_perp = 30,
tsne_iter = 1000,
umap_neighbors = 30,
umap_mindist = 0.3) {
if (!inherits(obj, "sciNOME")) stop("输入必须是 sciNOME 对象！")
# 获取指定的数据层
mat <- obj$assays$RNA[[layer_name]]
if(is.null(mat)) stop(paste("错误：找不到数据层", layer_name, "，请检查是否已进行标准化或Scale！"))
# 算法 A: PCA
if (method == "PCA") {
message(sprintf("正在 %s 层上计算高变基因(HVG)...", layer_name))
# 极速计算 HVG
rM <- Matrix::rowMeans(mat)
rVar <- Matrix::rowMeans(mat^2) - rM^2
hvgs <- names(sort(rVar, decreasing = TRUE))[1:min(n_hvg, length(rVar))]
obj$var.genes <- hvgs
message(sprintf("正在运行截断 SVD (PCA)，使用 %d 个特征基因...", length(hvgs)))
mat_hvg <- mat[hvgs, , drop = FALSE]
pca_res <- irlba::prcomp_irlba(Matrix::t(mat_hvg), n = pca_rank, center = TRUE, scale. = TRUE)
pca_coords <- pca_res$x
rownames(pca_coords) <- colnames(mat)
colnames(pca_coords) <- paste0("PC_", 1:ncol(pca_coords))
obj$reductions$pca <- pca_coords
obj$reductions$current_plot <- pca_coords[, 1:2]
colnames(obj$reductions$current_plot) <- c("Dim1", "Dim2")
obj$reductions$current_method <- "PCA"
message("PCA 完成！")
}
# 算法 B: t-SNE
else if (method == "t-SNE") {
if(is.null(obj$reductions$pca)) stop("找不到 PCA 结果！运行 t-SNE 前请先运行 PCA。")
message(sprintf("正在运行 t-SNE... (使用 PC 维度: %d 到 %d)", min(use_dims), max(use_dims)))
pca_input <- obj$reductions$pca[, use_dims, drop = FALSE]
tsne_res <- Rtsne::Rtsne(pca_input, pca = FALSE,
perplexity = tsne_perp,
max_iter = tsne_iter,
check_duplicates = FALSE)
tsne_coords <- tsne_res$Y
rownames(tsne_coords) <- rownames(pca_input)
colnames(tsne_coords) <- c("tSNE_1", "tSNE_2")
obj$reductions$tsne <- tsne_coords
obj$reductions$current_plot <- tsne_coords
colnames(obj$reductions$current_plot) <- c("Dim1", "Dim2")
obj$reductions$current_method <- "t-SNE"
message("t-SNE 坐标生成成功！")
}
# 算法 C: UMAP
else if (method == "UMAP") {
if(is.null(obj$reductions$pca)) stop("找不到 PCA 结果！运行 UMAP 前请先运行 PCA。")
message(sprintf("正在运行 UMAP... (使用 PC 维度: %d 到 %d)", min(use_dims), max(use_dims)))
pca_input <- obj$reductions$pca[, use_dims, drop = FALSE]
umap_res <- uwot::umap(pca_input,
n_neighbors = umap_neighbors,
min_dist = umap_mindist,
n_components = 2,
fast_sgd = TRUE)
umap_coords <- umap_res
rownames(umap_coords) <- rownames(pca_input)
colnames(umap_coords) <- c("UMAP_1", "UMAP_2")
obj$reductions$umap <- umap_coords
obj$reductions$current_plot <- umap_coords
colnames(obj$reductions$current_plot) <- c("Dim1", "Dim2")
obj$reductions$current_method <- "UMAP"
message("UMAP 坐标生成成功！")
} else {
stop("不支持的降维方法，请选择 'PCA', 't-SNE', 或 'UMAP'。")
}
return(obj)
}
#' Run Clustering for sciNOME Object
#'
#' @description Performs cell/sample clustering using either a Graph-based (Leiden) approach or Hierarchical clustering.
#'
#' @param obj A \code{sciNOME} object (Requires prior dimensionality reduction).
#' @param reduction Character. Which reduction to use: "pca" (recommended), "umap", or "tsne".
#' @param method Character. Clustering algorithm: "graph" (KNN + Leiden) or "hierarchical".
#' @param use_dims Integer vector. Dimensions to extract from the reduction (e.g., 1:20).
#' @param cluster_res Numeric. Resolution parameter for Leiden algorithm (larger values = more clusters).
#' @param k_neighbors Integer. Number of neighbors for K-NN graph construction.
#' @param cluster_k Integer. Fixed number of clusters (k) for hierarchical clustering.
#'
#' @return A \code{sciNOME} object with \code{Auto_Cluster} added to its \code{filter_meta.data}.
#'
#' @importFrom stats dist hclust cutree
#' @importFrom igraph graph_from_edgelist simplify cluster_leiden
#' @export
RunClustering_RNA <- function(obj,
reduction = "pca",
method = "graph",
use_dims = 1:20,
cluster_res = 0.8,k_neighbors = 20,
cluster_k = 5) {
if (!inherits(obj, "sciNOME")) stop("输入必须是 sciNOME 对象！")
# --- 1. 动态提取指定的降维数据 ---
# 统一名称格式，防止用户输入大小写不一致或带连字符
reduction_key <- tolower(reduction)
if (reduction_key == "t-sne") reduction_key <- "tsne"
coord_mat <- obj$reductions[[reduction_key]]
if (is.null(coord_mat)) {
stop(sprintf("错误：找不到 '%s' 的降维结果！请先运行 RunDimReduction_sciNOME 生成该数据。", reduction))
}
# --- 2. 维度安全截断 ---
# 防止指定的维度超出实际存在的维度 (例如 UMAP 通常只有 2 维，而 use_dims 可能是 1:20)
start_dim <- max(1, min(use_dims))
end_dim <- min(max(use_dims), ncol(coord_mat))
if (start_dim > end_dim) {
stop(sprintf("错误：指定的 use_dims 超出范围。'%s' 只有 %d 个维度。", reduction, ncol(coord_mat)))
}
cluster_input <- coord_mat[, start_dim:end_dim, drop = FALSE]
message(sprintf("正在提取 %s (维度 %d 到 %d) 用于聚类...", toupper(reduction), start_dim, end_dim))
# --- 3. 算法 A: Graph-based (KNN + Leiden) ---
if (method == "graph") {
message(sprintf("正在构建 K-NN 图 (FNN, k=%d)...", k_neighbors))
# 防范样本数少于 k 的情况
k_n <- min(k_neighbors, nrow(cluster_input) - 1)
if (k_n < 1) stop("样本数量太少，无法构建 K-NN 图！")
knn_res <- FNN::get.knn(cluster_input, k = k_n)
edges <- do.call(rbind, lapply(1:nrow(cluster_input), function(i) {
cbind(rep(i, k_n), knn_res$nn.index[i, ])
}))
message(sprintf("正在运行 Leiden 社区发现算法 (Resolution=%.2f)...", cluster_res))
g <- igraph::graph_from_edgelist(edges, directed = FALSE)
g <- igraph::simplify(g)
leiden_res <- igraph::cluster_leiden(g, resolution_parameter = cluster_res)
cluster_labels <- paste0("Cluster_", leiden_res$membership)
}
# --- 4. 算法 B: Hierarchical Clustering ---
else if (method == "hierarchical") {
message(sprintf("正在运行层次聚类 (ward.D2, k=%d)...", cluster_k))
d_mat <- stats::dist(cluster_input)
hc_res <- stats::hclust(d_mat, method = "ward.D2")
# 防范 k 大于样本数
actual_k <- min(cluster_k, nrow(cluster_input))
cluster_labels <- paste0("Cluster_", stats::cutree(hc_res, k = actual_k))
} else {
stop("不支持的聚类方法，请选择 'graph' 或 'hierarchical'。")
}
# --- 5. 因子化：优雅排序 ---
# 保证 Cluster_2 排在 Cluster_10 前面
cluster_nums <- as.numeric(gsub("Cluster_", "", cluster_labels))
sorted_levels <- paste0("Cluster_", sort(unique(cluster_nums)))
cluster_factor <- factor(cluster_labels, levels = sorted_levels)
# 将标签安全写入 Metadata 中
if (!is.null(obj$filter_meta.data)) {
obj$filter_meta.data$Auto_Cluster <- cluster_factor
}
# 同时写入原 meta.data 以保持全局数据结构的完整性
common_cells <- intersect(rownames(obj$meta.data), rownames(cluster_input))
obj$meta.data[common_cells, "Auto_Cluster"] <- cluster_factor
message(sprintf("聚类完成！共发现 %d 个集群 (Clusters)。已写入 filter_meta.data$Auto_Cluster。", length(sorted_levels)))
return(obj)
}
#' Run Differential Expression Analysis (Wilcoxon Rank Sum Test)
#'
#' @description Extremely fast implementation of Wilcoxon Rank Sum Test for discovering differentially expressed genes between groups.
#' Automatically handles 1-vs-1 or 1-vs-Rest comparisons.
#'
#' @param obj A \code{sciNOME} object.
#' @param layer_name Character. Data layer to use: "data" (recommended for log2FC) or "scale.data".
#' @param group_col Character. Column name in \code{filter_meta.data} used for grouping cells.
#' @param ident_1 Character. The target cluster/group name (Required).
#' @param ident_2 Character. The control group name. If \code{NULL}, computes \code{ident_1} vs all other groups (Rest).
#' @param min_pct Numeric. Minimum fraction of cells expressing the gene in either group to retain for testing.
#' @param logfc_thresh Numeric. Minimum absolute log2 fold change (or mean difference) required.
#'
#' @return A sorted \code{data.frame} of DEA results containing p-values, adjusted p-values, FC/Diff, and expression percentages.
#'
#' @importFrom Matrix rowSums rowMeans
#' @importFrom stats wilcox.test p.adjust
#' @export
RunDEA_RNA <- function(obj,
layer_name = "data",
group_col = "Auto_Cluster",
ident_1 = NULL,ident_2 = NULL,
min_pct = 0.1,logfc_thresh = 0.25) {
if (!inherits(obj, "sciNOME")) stop("输入必须是 sciNOME 对象！")
# --- 1. 获取 Metadata 和分组检查 ---
meta <- obj$filter_meta.data
if (is.null(meta)) stop("找不到 filter_meta.data，请先运行质控过滤！")
if (!(group_col %in% colnames(meta))) stop(sprintf("列名 '%s' 不在 filter_meta.data 中！", group_col))
group_vec <- as.character(meta[[group_col]])
# 强制要求 ident_1 不能为空
if (is.null(ident_1)) {
stop("错误：ident_1 不能为空！必须指定目标组。")
}
if (!(ident_1 %in% group_vec)) {
stop(sprintf("错误：ident_1 ('%s') 在列 %s 中不存在！", ident_1, group_col))
}
cells_1 <- rownames(meta)[which(group_vec == ident_1)]
# --- 2. 智能划分细胞组 (自动判定比较模式) ---
if (is.null(ident_2)) {
# 如果 ident_2 为空，自动执行 ident_1 vs Rest (其他所有组)
cells_2 <- rownames(meta)[which(group_vec != ident_1 & !is.na(group_vec))]
ident_2_name <- "Rest"
message(sprintf("未指定 ident_2，自动执行 '%s' vs '其他所有组(Rest)' 的分析。", ident_1))
} else {
# 如果 ident_2 有值，自动执行 ident_1 vs ident_2
if (ident_1 == ident_2) stop("错误：ident_1 和 ident_2 不能是同一个组！")
if (!(ident_2 %in% group_vec)) stop(sprintf("错误：ident_2 ('%s') 在列 %s 中不存在！", ident_2, group_col))
cells_2 <- rownames(meta)[which(group_vec == ident_2)]
ident_2_name <- ident_2
message(sprintf("检测到 ident_2，执行精准对比：'%s' vs '%s'。", ident_1, ident_2))
}
# 细胞数量检查
if (length(cells_1) < 3 || length(cells_2) < 3) {
stop("其中一组的细胞/样本数量少于 3 个，无法进行可靠的统计检验！")
}
# --- 3. 获取矩阵层 ---
if (!(layer_name %in% c("data", "scale.data"))) {
stop("layer_name 必须是 'data' 或 'scale.data'")
}
mat <- obj$assays$RNA[[layer_name]]
if (is.null(mat)) stop(sprintf("找不到层 '%s'，请先运行标准化或 Scale。", layer_name))
message(sprintf("正在提取组 1 (%s, N=%d) 和 组 2 (%s, N=%d) 的数据...", ident_1, length(cells_1), ident_2_name, length(cells_2)))
# 分割矩阵
mat_1 <- mat[, cells_1, drop = FALSE]
mat_2 <- mat[, cells_2, drop = FALSE]
# --- 4. 极速计算表达比例 (pct.1, pct.2) ---
message("正在计算表达比例 (Percentages)...")
pct_1 <- round(Matrix::rowSums(mat_1 > 0) / length(cells_1), 3)
pct_2 <- round(Matrix::rowSums(mat_2 > 0) / length(cells_2), 3)
# --- 5. 计算变化倍数 (Fold Change / Difference) ---
message("正在计算变化幅度...")
if (layer_name == "data") {
# 假设 data 是 log1p 后的数据，计算严谨的 log2FC：
# 先 expm1 还原为原始表达量求均值，再求 log2。
mat_1_exp <- mat_1; mat_1_exp@x <- expm1(mat_1_exp@x)
mat_2_exp <- mat_2; mat_2_exp@x <- expm1(mat_2_exp@x)
mean_1 <- Matrix::rowMeans(mat_1_exp)
mean_2 <- Matrix::rowMeans(mat_2_exp)
# 防止 log2(0)，加入伪计数
log2fc <- log2(mean_1 + 1e-9) - log2(mean_2 + 1e-9)
fc_col_name <- "avg_log2FC"
} else {
# 如果是 scale.data (含负值的 z-score)，算 FC 会产生 NaN
# 此时直接计算均值差 (Mean Difference)
mean_1 <- Matrix::rowMeans(mat_1)
mean_2 <- Matrix::rowMeans(mat_2)
log2fc <- mean_1 - mean_2
fc_col_name <- "mean_diff" # 更改列名以防误导
}
# --- 6. 预过滤 (显著加速后续 p-value 计算) ---
genes_pass <- names(which(
(pct_1 >= min_pct | pct_2 >= min_pct) & abs(log2fc) >= logfc_thresh
))
if (length(genes_pass) == 0) {
stop("没有基因通过 min_pct 和 logfc_thresh 的预先过滤！请尝试降低阈值。")
}
# --- 7. Wilcoxon Rank Sum Test ---
message(sprintf("对 %d 个候选基因执行 Wilcoxon Rank Sum Test...", length(genes_pass)))
# 提取需要检验的子矩阵并转为普通矩阵 (提高逐行抽取的极速)
test_mat_1 <- as.matrix(mat_1[genes_pass, , drop = FALSE])
test_mat_2 <- as.matrix(mat_2[genes_pass, , drop = FALSE])
p_vals <- sapply(1:length(genes_pass), function(i) {
x <- test_mat_1[i, ]
y <- test_mat_2[i, ]
# 关闭 exact 和 correct 以加速大规模计算
res <- stats::wilcox.test(x, y, exact = FALSE, correct = FALSE)
return(res$p.value)
})
# --- 8. 整理结果与多重检验校正 ---
message("正在格式化输出结果...")
res_df <- data.frame(
gene = genes_pass,
p_val = p_vals,
FC_metric = log2fc[genes_pass],
pct.1 = pct_1[genes_pass],
pct.2 = pct_2[genes_pass],
cluster = ident_1,
comparison = paste0(ident_1, " vs ", ident_2_name),
stringsAsFactors = FALSE
)
# 动态命名 FC 列
colnames(res_df)[3] <- fc_col_name
# 计算 FDR (BH校正)
res_df$p_val_adj <- stats::p.adjust(res_df$p_val, method = "BH")
# 调整列顺序：gene, p_val, avg_log2FC, pct.1, pct.2, p_val_adj, cluster, comparison
res_df <- res_df[, c("gene", "p_val", fc_col_name, "pct.1", "pct.2", "p_val_adj", "cluster", "comparison")]
# 按 p_val 从小到大排序
res_df <- res_df[order(res_df$p_val), ]
rownames(res_df) <- NULL
message(sprintf("DEA 完成！找到 %d 个显著差异基因。", nrow(res_df)))
return(res_df)
}
#' Run Pseudotime and Trajectory Inference
#'
#' @description Computes cellular pseudotime using either a cluster-based Principal Curve method or a graph-based K-NN shortest path method.
#'
#' @param obj A \code{sciNOME} object.
#' @param reduction Character. Embedding to use: "umap" (recommended), "tsne", or "pca".
#' @param group_col Character. Column name in \code{filter_meta.data} defining clusters. Defaults to "Auto_Cluster".
#' @param start_clus Character. Name of the root/starting cluster (Required).
#' @param algorithm Character. Trajectory algorithm: "cluster" (Principal Curve) or "graph" (KNN Shortest Path).
#'
#' @return A \code{sciNOME} object with \code{Pseudotime} stored in \code{filter_meta.data} and detailed trajectory info in \code{reductions$pseudotime}.
#'
#' @importFrom igraph graph_from_edgelist simplify distances V
#' @export
RunPseudotime_RNA <- function(obj,
reduction = "umap",
group_col = "Auto_Cluster",
start_clus = NULL,algorithm = "cluster") {
if (!inherits(obj, "sciNOME")) stop("输入必须是 sciNOME 对象！")
# --- 1. 严格锁定 filter_meta.data ---
meta <- obj$filter_meta.data
if (is.null(meta)) stop("错误：找不到 filter_meta.data！请先运行质控过滤。")
if (!(group_col %in% colnames(meta))) stop(sprintf("错误：列名 '%s' 不在 filter_meta.data 中！", group_col))
if (is.null(start_clus)) stop("错误：必须指定发育起点 (start_clus)！例如 start_clus = 'Cluster_1'")
# --- 2. 获取起点样本 ---
group_vec <- as.character(meta[[group_col]])
start_cells <- rownames(meta)[which(group_vec == start_clus)]
if (length(start_cells) == 0) {
stop(sprintf("错误：在 filter_meta.data 的 '%s' 列中，找不到名为 '%s' 的分组！", group_col, start_clus))
}
message(sprintf("已识别到 %d 个起点样本 (属于 %s)。", length(start_cells), start_clus))
# --- 3. 获取降维坐标并严格与 filter_meta.data 对齐 ---
reduction_key <- tolower(reduction)
if (reduction_key == "t-sne") reduction_key <- "tsne"
raw_coords <- obj$reductions[[reduction_key]]
if (is.null(raw_coords)) stop(sprintf("错误：找不到降维数据 '%s'！请先运行降维分析。", reduction))
# 核心对齐：仅保留存在于 filter_meta.data 中的样本的坐标
valid_cells <- intersect(rownames(meta), rownames(raw_coords))
if (length(valid_cells) == 0) stop("错误：filter_meta.data 的样本名与降维坐标的样本名完全不匹配！")
coords <- raw_coords[valid_cells, 1:2, drop = FALSE] # 强行限制在 2D 空间进行拟时序
start_cells <- intersect(start_cells, valid_cells)   # 确保起点细胞有效
# --- 4. 核心算法分支 ---
if (algorithm == "cluster") {
# 引擎 A: Cluster-based (主曲线拟合, 类似 Slingshot)
message("正在运行基于 Cluster 的主曲线拟合 (princurve)...")
if (!requireNamespace("princurve", quietly = TRUE)) stop("请安装 princurve 包 (install.packages('princurve'))！")
fit <- princurve::principal_curve(coords, smoother = "smooth.spline")
pt <- fit$lambda
names(pt) <- rownames(coords)
curve_out <- fit$s # 提取平滑的主曲线骨架坐标
message("正在校准生物学时间箭头...")
mean_pt_start <- mean(pt[names(pt) %in% start_cells], na.rm = TRUE)
mean_pt_all <- mean(pt, na.rm = TRUE)
# 如果起点的均值时间大于全局均值，说明曲线跑反了，需要翻转
if (mean_pt_start > mean_pt_all) {
pt <- max(pt, na.rm = TRUE) - pt
}
} else if (algorithm == "graph") {
# 引擎 B: Graph-based (图论最短路径, 类似 Monocle3)
message("正在运行基于 Graph 的 K-NN 图网络推断...")
k_neighbors <- min(15, nrow(coords) - 1)
knn_res <- FNN::get.knn(coords, k = k_neighbors)
edges <- do.call(rbind, lapply(1:nrow(coords), function(i) {
cbind(rep(i, k_neighbors), knn_res$nn.index[i, ])
}))
g <- igraph::graph_from_edgelist(edges, directed = FALSE)
g <- igraph::simplify(g)
message("正在计算网络图的最短路径距离 (Pseudotime)...")
start_indices <- which(rownames(coords) %in% start_cells)
dist_matrix <- igraph::distances(g, v = start_indices, to = igraph::V(g))
pt <- apply(dist_matrix, 2, min)
names(pt) <- rownames(coords)
# 处理孤岛细胞 (无法连通的节点)
finite_max <- max(pt[is.finite(pt)])
pt[is.infinite(pt)] <- finite_max * 1.1
curve_out <- NULL # 树状图不输出单一骨架坐标
} else {
stop("不支持的 algorithm 参数！请选择 'cluster' 或 'graph'。")
}
# --- 5. 结果整理与保存 ---
message("正在将拟时序归一化至 0-1 之间...")
pt <- (pt - min(pt, na.rm = TRUE)) / (max(pt, na.rm = TRUE) - min(pt, na.rm = TRUE))
# 存入标准底层位置
obj$reductions$pseudotime <- list(
pseudotime = pt,
curve_coords = curve_out,
dr_method = reduction_key,
start_clus = start_clus,
group_col = group_col,
algorithm = algorithm
)
# 关键步骤：直接写入 filter_meta.data 供下游快速调用
# 因为前面用 valid_cells 做了交集，这里直接按名字匹配赋给 filter_meta.data，非常安全。
obj$filter_meta.data$Pseudotime <- NA # 先全用 NA 填充兜底
obj$filter_meta.data[names(pt), "Pseudotime"] <- pt
message(sprintf("轨迹推断完成 (%s)！拟时数据已保存至 filter_meta.data$Pseudotime。", toupper(algorithm)))
return(obj)
}
PlotQC_RNA(my_scinome_obj,"group1")
#' @param obj A \code{sciNOME} object containing calculated QC metrics in \code{meta.data}.
#' @param group_col Character. The column name in \code{meta.data} to group cells by. If NULL or not found, defaults to "orig.ident".
#' @param features Character vector. The QC metrics to plot. Defaults to \code{c("nFeature_RNA", "nCount_RNA", "percent_mt")}.
#'
#' @return A \code{ggplot} object representing the QC metrics violin plots.
#'
#' @importFrom tidyr pivot_longer
#' @importFrom grDevices colorRampPalette
#' @importFrom ggplot2 ggplot aes geom_violin geom_jitter facet_wrap theme_bw labs theme element_text element_rect element_blank margin scale_fill_manual
#' @export
PlotQC_RNA <- function(obj,
group_col = NULL,
features = c("nFeature_RNA", "nCount_RNA", "percent_mt")) {
if (!inherits(obj, "sciNOME")) stop("输入必须是 sciNOME 对象！")
meta <- obj$meta.data
if (is.null(meta)) stop("错误：找不到 meta.data，请检查对象是否完整。")
# --- 1. 检查并提取需要绘图的特征列 ---
missing_features <- setdiff(features, colnames(meta))
if (length(missing_features) > 0) {
stop(sprintf("错误：在 meta.data 中找不到特征列: %s。请先执行 QC 计算步骤。",
paste(missing_features, collapse = ", ")))
}
# --- 2. 安全获取绘图分组列名 ---
if (is.null(group_col) || !(group_col %in% colnames(meta))) {
if ("orig.ident" %in% colnames(meta)) {
group_col <- "orig.ident"
message("未指定有效的分组列或列名不存在，已默认使用 'orig.ident'。")
} else {
# 如果连 orig.ident 都没有，创建一个虚拟的全集分组
meta$All_Cells <- "All_Cells"
group_col <- "All_Cells"
message("未找到分组信息，所有细胞将作为一个整体显示。")
}
}
# --- 3. 数据清洗与因子化 ---
# 提取所需的列，避免加载整个庞大的 metadata
plot_data <- meta[, c(group_col, features), drop = FALSE]
colnames(plot_data)[1] <- "Plot_Group" # 统一命名，方便 ggplot 映射
# 防止因为 NA 或空字符串导致 ggplot2 崩溃
plot_data$Plot_Group <- as.character(plot_data$Plot_Group)
plot_data$Plot_Group[is.na(plot_data$Plot_Group) | plot_data$Plot_Group == ""] <- "Unknown"
plot_data$Plot_Group <- as.factor(plot_data$Plot_Group)
# --- 4. 宽表转长表 (专为 ggplot 分面设计) ---
qc_long <- tidyr::pivot_longer(
data = plot_data,
cols = all_of(features),
names_to = "Metric",
values_to = "Value"
)
# 固定面板顺序与用户输入的 features 顺序一致
qc_long$Metric <- factor(qc_long$Metric, levels = features)
# --- 5. 动态扩增颜色系统 ---
sci_palette <- c("#E64B35FF", "#4DBBD5FF", "#00A087FF", "#3C5488FF",
"#F39B7FFF", "#8491B4FF", "#91D1C2FF", "#DC0000FF",
"#7E6148FF", "#B09C85FF", "#FF7F00", "#6A3D9A")
num_groups <- length(levels(qc_long$Plot_Group))
if (num_groups <= length(sci_palette)) {
# 如果分组数 <= 12，严格依次提取原色
dynamic_colors <- sci_palette[1:num_groups]
} else {
# 如果分组数 > 12，通过插值算法生成平滑过渡的新颜色集
dynamic_colors <- grDevices::colorRampPalette(sci_palette)(num_groups)
}
# --- 6. 高级 ggplot2 原生渲染输出 ---
p_qc <- ggplot2::ggplot(qc_long, ggplot2::aes(x = Plot_Group, y = Value, fill = Plot_Group)) +
ggplot2::geom_violin(trim = FALSE, color = "black", alpha = 0.9, scale = "width", linewidth = 0.6) +
ggplot2::geom_jitter(width = 0.2, size = 0.5, alpha = 0.3, color = "grey30") +
ggplot2::facet_wrap(~ Metric, scales = "free_y", ncol = length(features), strip.position = "top") +
ggplot2::theme_bw(base_size = 14) +
ggplot2::labs(x = group_col, y = "Metric Value") +
ggplot2::theme(
legend.position = "none",
axis.title.x = ggplot2::element_text(face = "bold", size = 14, margin = ggplot2::margin(t = 10)),
axis.text.x = ggplot2::element_text(angle = 45, hjust = 1, face = "bold", color = "black"),
axis.text.y = ggplot2::element_text(color = "black"),
strip.background = ggplot2::element_rect(fill = "#f8f9fa", color = "black", linewidth = 1),
strip.text = ggplot2::element_text(face = "bold", size = 14, color = "#2C3E50"),
panel.grid.major.x = ggplot2::element_blank(),
panel.grid.minor.x = ggplot2::element_blank(),
panel.border = ggplot2::element_rect(color = "black", linewidth = 1.2)
) +
ggplot2::scale_fill_manual(values = dynamic_colors)
return(p_qc)
}
PlotQC_RNA(my_scinome_obj,"group1")
my_scinome_obj <- ProcessQC_RNA(
obj = my_scinome_obj,
mt_pattern = "^MT-",          # 人的线粒体前缀
min_nCount = 100,             # 至少 500 UMI
max_nCount = 8000000,           # 最多 50000 UMI
min_nFeature = 200,           # 至少表达 200 个基因
max_nFeature = 8000,          # 最多表达 8000 个基因
max_mt = 10,                  # 线粒体比例不能超过 10%
norm_method = "LogNormalize", # 标准化方法
do_scale = TRUE               # 是否做 scale
)
